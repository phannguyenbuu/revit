<Page x:Class="RevitMcpBridge.ChatbotPaneView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="360"
      Background="#1E222B" Foreground="#E0E6ED"
      FontFamily="Segoe UI, Tahoma, sans-serif">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D3342" />
            <Setter Property="Foreground" Value="#61AFEF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#3E4451" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E4451" />
                    <Setter Property="Foreground" Value="#98C379" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Quick Actions -->
            <RowDefinition Height="*" />    <!-- Chat History -->
            <RowDefinition Height="Auto" /> <!-- Input -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Border Grid.Row="0" Background="#21252B" BorderBrush="#282C34" BorderThickness="0,0,0,1" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🤖" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Revit AI Chatbot" FontWeight="SemiBold" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <Border Background="#2C313C" CornerRadius="3" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="2025" FontSize="10" FontWeight="Bold" Foreground="#98C379" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtStatus" Text="🟢 MCP Server: Online" FontSize="10" Foreground="#ABB2BF" Margin="22,2,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Xoá lịch sử" Click="BtnClearHistory_Click"
                        Background="Transparent" BorderThickness="0" Foreground="#5C6370" FontSize="11" Cursor="Hand" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 2. Quick Actions -->
        <Border Grid.Row="1" Background="#282C34" Padding="8,6" BorderBrush="#21252B" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal">
                <Button Content="🎨 Đổi màu FK2025" Style="{StaticResource ActionButtonStyle}" Click="BtnColor_Click" ToolTip="Áp dụng bảng màu chuẩn FK2025 (Lidl Blue, Red, Yellow, White)" />
                <Button Content="🔍 Soát Family" Style="{StaticResource ActionButtonStyle}" Click="BtnInspect_Click" ToolTip="Kiểm tra đối tượng Solid và vật liệu trong Family" />
                <Button Content="📊 Thống kê" Style="{StaticResource ActionButtonStyle}" Click="BtnModel_Click" ToolTip="Lấy tổng quan số lượng Levels, Grids, Sheets" />
                <Button Content="💾 Lưu file" Style="{StaticResource ActionButtonStyle}" Click="BtnSave_Click" ToolTip="Lưu tài liệu hiện tại" />
            </WrapPanel>
        </Border>

        <!-- 3. Chat History -->
        <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
            <ItemsControl x:Name="ChatItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <!-- User Message -->
                            <Border Background="#2D3B55" CornerRadius="10,10,2,10" Padding="10,8"
                                    HorizontalAlignment="Right" MaxWidth="280"
                                    Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#FFFFFF" FontSize="12.5" />
                                    <TextBlock Text="{Binding Timestamp}" Foreground="#828997" FontSize="9" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Assistant / Bot Message -->
                            <Border Background="#252A34" BorderBrush="#353B48" BorderThickness="1" CornerRadius="10,10,10,2" Padding="10,8"
                                    HorizontalAlignment="Left" MaxWidth="310"
                                    Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="🤖 Assistant" FontWeight="SemiBold" FontSize="10" Foreground="#61AFEF" />
                                        <TextBlock Text="{Binding Timestamp}" Foreground="#5C6370" FontSize="9" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#E0E6ED" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 4. Input Area -->
        <Border Grid.Row="3" Background="#21252B" BorderBrush="#282C34" BorderThickness="0,1,0,0" Padding="8,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtInput" KeyDown="TxtInput_KeyDown"
                         Background="#2C313C" Foreground="#FFFFFF" BorderBrush="#3E4451" BorderThickness="1"
                         Padding="8,6" FontSize="12.5" TextWrapping="Wrap" MaxHeight="80"
                         VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                         ToolTip="Nhấn Enter để gửi, Shift+Enter để xuống dòng" />

                <Button Grid.Column="1" Content="Gửi" Click="BtnSend_Click" Margin="6,0,0,0"
                        Background="#007ACC" Foreground="#FFFFFF" FontWeight="SemiBold"
                        Padding="14,6" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
